# 日报任务：脚本抓取 → Agent 生成 → 按 depth 分支
# 覆盖：string / select / password / number 变量、包内脚本、Agent、
#       Select + Case + Default、模板多变量、密码脱敏
@var city: string = "北京"                      # 要生成日报的城市
@var depth: select("简版", "详细") = "简版"      # 日报详细程度
@var token: password!                           # 抓取接口的访问令牌
@var lines: number = 5

[Start]

-> [Script(`scripts/fetch.cmd ${city} ${token}`)]

-> [Agent(`根据 ${city} 的抓取结果生成${depth}日报，写入 report.md`, timeout: 120)]

-> [Select]

    -> [Case(${depth} == "详细")]
        -> [Script(`node -e "console.log('详细日报已生成，共 ' + process.argv[1] + ' 行')" ${lines}`)]

    -> [Default]
        -> [Script(`node -e "console.log('简版日报已生成')"`)]

[End]
